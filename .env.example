# Required for durable Drizzle/MySQL persistence when you wire the request store.
DATABASE_URL=mysql://user:password@host:3306/database

# Keep Daraja secrets server-side only. Never prefix these with VITE_.
DARAJA_CONSUMER_KEY=replace_me
DARAJA_CONSUMER_SECRET=replace_me
DARAJA_SHORTCODE=replace_me
DARAJA_PASSKEY=replace_me
DARAJA_CALLBACK_URL=https://your-domain.example/api/daraja/callback

# Vercel/runtime
NODE_ENV=production
